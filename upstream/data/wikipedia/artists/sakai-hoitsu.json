        "license": "CC0",
        "licenseUrl": "http://creativecommons.org/publicdomain/zero/1.0/deed.en",
        "page": "https://commons.wikimedia.org/wiki/File:Sakai_Hoitsu_-_Paulownias_and_Chrysanthemums_-_1964.386_-_Cleveland_Museum_of_Art.tif"
      }
