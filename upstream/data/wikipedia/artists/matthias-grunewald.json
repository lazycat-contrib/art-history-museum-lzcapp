    {
      "slug": "saint-erasmus-and-saint-maurice",
      "title": "Saint Erasmus and Saint Maurice",
      "year": 1520,
      "imageUrl": "https://upload.wikimedia.org/wikipedia/commons/e/ea/Mathis_Gothart_Gr%C3%BCnewald_011.jpg",
      "imageWidth": 2536,
      "imageHeight": 3265,
      "story": "Saint Erasmus and Saint Maurice is an oil on wood painting by German artist Matthias Grünewald. It was commissioned by Albert of Brandenburg, executed between 1520 and 1524, and originally intended for the new cathedral in Halle. It is now held at the Alte Pinakothek in Munich.",
      "facts": [
        "Saint Erasmus stands dressed in luxurious episcopal vestments, on the left.",
        "He holds in his right hand the testimony of his martyrdom, the spindle wrapped in entrails torn from his body with a ship's winch."
      ],
