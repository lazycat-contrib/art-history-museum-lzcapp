    {
      "slug": "the-slav-epic",
      "title": "The Slav Epic",
      "year": 1910,
      "imageUrl": "https://upload.wikimedia.org/wikipedia/commons/e/e3/Alfons_Mucha_at_work_on_Slav_Epic.jpg",
      "imageWidth": 736,
      "imageHeight": 574,
      "story": "The Slav Epic is a cycle of 20 large canvases painted by Czech Art Nouveau painter Alphonse Mucha between 1910 and 1928. The cycle depicts the mythology and history of Czechs and other Slavic peoples. In 1928, after finishing his monumental work, Mucha bestowed the cycle upon the city of Prague on the condition that the city build a special pavilion for it.",
      "facts": [
        "During World War II, The Slav Epic was wrapped and hidden away to prevent seizure by the Nazis.",
        "Nevertheless, in early 2010, the city of Prague requested the return of The Slav Epic for restoration work and subsequent display."
      ],
      "wikipediaUrl": "https://en.wikipedia.org/wiki/The_Slav_Epic",
