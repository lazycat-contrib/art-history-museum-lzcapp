    {
      "slug": "haboku-sansui",
      "title": "Haboku sansui",
      "year": 1495,
      "imageUrl": "https://upload.wikimedia.org/wikipedia/commons/2/27/Sesshu_-_Haboku-Sansui.jpg",
      "imageWidth": 6976,
      "imageHeight": 10784,
      "story": "Haboku sansui  is a splashed-ink landscape painting on a hanging scroll. It was made by the Japanese artist Sesshū Tōyō in 1495, in the Muromachi period. The ink wash painting is classified as a National Treasure of Japan and currently held by the Tokyo National Museum.",
      "facts": [
        "The work is a development of suibokuga (水墨画) paintings made with Chinese ink (墨, sumi), using dark and light shades on a silk or paper medium.",
        "The monochromatic style can result in artworks similar to calligraphy."
      ],
      "wikipediaUrl": "https://en.wikipedia.org/wiki/Haboku_sansui",
